# Nullapart Frontend — Vite React build
FROM node:24-slim AS builder

RUN corepack enable && corepack prepare pnpm@11.5.0 --activate

WORKDIR /app
COPY .npmrc package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
# Build-time telemetry configuration (docs/11): Vite embeds VITE_* env at
# build; empty leaves the telemetry module inert in the browser bundle.
ARG VITE_TELEMETRY_DSN=""
ARG VITE_TELEMETRY_ENVIRONMENT=""
ARG VITE_TELEMETRY_RELEASE=""
ENV VITE_TELEMETRY_DSN=$VITE_TELEMETRY_DSN \
    VITE_TELEMETRY_ENVIRONMENT=$VITE_TELEMETRY_ENVIRONMENT \
    VITE_TELEMETRY_RELEASE=$VITE_TELEMETRY_RELEASE
RUN pnpm build

FROM nginx:alpine
RUN apk add --no-cache apache2-utils
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY 20-local-basic-auth.sh /docker-entrypoint.d/20-local-basic-auth.sh
RUN chmod 0755 /docker-entrypoint.d/20-local-basic-auth.sh
EXPOSE 80
