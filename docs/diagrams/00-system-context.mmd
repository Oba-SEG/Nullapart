flowchart LR
    Internet((Internet))
    CustomerMail[Customer Mail Systems]
    Admins[System / Support / Customer Admins]

    subgraph Deployment["Nullapart Regional Deployment"]
        subgraph MailPlane["Mail Plane"]
            Postfix[Postfix SMTP + Durable Queue]
            Rspamd[Rspamd Milter]
            MailCore[Rust Mail Core\nSMTP Transaction + Tenant Message Instances]
            Scanners[Scanner Fabric]
            InlineML[Inline ML]
            Policy[Per-Tenant Policy Runtime]
            Quarantine[Quarantine / Hold]
            Reinject[Trusted Reinjection]
        end

        subgraph ControlPlane["Control Plane"]
            UI[Flat Admin Console UI]
            Control[Control Backend]
            Identity[ZITADEL]
            Config[(PostgreSQL)]
            Cache[(Redis / Valkey)]
            Secrets[OpenBao]
            Audit[(Admin Audit Store)]
        end

        subgraph Intelligence["Intelligence / Operations"]
            DMARC[DMARC + BIMI]
            DeepAI[Regional Deep AI]
            Outbox[(Transactional Outbox)]
            SQS[(Amazon SQS)]
            N8N[n8n]
            ClickUp[ClickUp]
            Notify[Notifications]
        end

        Artifacts[(S3 Artifact Store)]
    end

    Internet --> Postfix
    CustomerMail <--> Postfix
    Postfix --> Rspamd --> MailCore
    MailCore --> Scanners
    MailCore --> InlineML
    MailCore --> Policy
    Policy --> Quarantine
    Policy --> Reinject --> Postfix
    MailCore --> Artifacts

    Admins --> UI --> Control
    Control --> Identity
    Control --> Config
    Control --> Cache
    Control --> Secrets
    Control --> Audit

    MailCore --> Outbox
    Control --> Outbox
    DMARC --> Outbox
    DeepAI --> Outbox
    Outbox --> SQS
    SQS --> N8N --> ClickUp
    SQS --> Notify
