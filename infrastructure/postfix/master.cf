# Nullapart Postfix master.cf - Service definitions
# Follows: docs/phases/PHASE-1-EXECUTION-PLAN.md Work Package 2

# ==============================================================================
# Inbound SMTP listener (public, TCP 25)
# ==============================================================================
smtp      inet  n       -       n       -       -       smtpd
  -o content_filter=mailcore:dummy
  -o smtpd_relay_restrictions=permit_mynetworks,reject_unauth_destination
  -o smtpd_recipient_restrictions=permit_mynetworks,reject_unauth_destination,reject_non_fqdn_recipient
  -o receive_override_options=no_header_body_checks
  -o smtp_helo_timeout=300
  -o smtp_bind_address=0.0.0.0

# ==============================================================================
# Reinjection listener (private Docker network only; never host-published)
# Accepts only Mail Core reinjection. Loop prevention header checked.
# ==============================================================================
10026 inet  n       -       n       -       -       smtpd
  -o content_filter=
  -o smtpd_milters=
  -o receive_override_options=no_unknown_recipient_checks
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o mynetworks=172.30.0.10/32
  -o smtpd_client_restrictions=permit_mynetworks,reject

# ==============================================================================
# Outbound SMTP (private, used by Mail Core for delivery)
# ==============================================================================
10027 inet  n       -       n       -       -       smtpd
  -o content_filter=
  -o receive_override_options=no_unknown_recipient_checks,no_header_body_checks
  -o smtpd_relay_restrictions=permit_mynetworks,reject
  -o smtpd_recipient_restrictions=permit_mynetworks,reject
  -o mynetworks=172.30.0.10/32
  -o smtpd_client_restrictions=permit_mynetworks,reject

# ==============================================================================
# Mail Core after-queue content filter
# mailcore_time_limit bounds the pipe command (pipe(8) transport override for
# command_time_limit, default 1000s). It sits above the filter's own 240s HTTP
# timeout so a stalled handoff exits EX_TEMPFAIL (queue retry) before Postfix
# kills the process.
# ==============================================================================
mailcore unix  -       n       n       -       10      pipe
  flags=Rq user=nullapart null_sender=<>
  -o mailcore_time_limit=300s
  argv=/usr/libexec/nullapart/mailcore-filter-wrapper --queue-id ${queue_id} --client-address ${client_address} --client-hostname ${client_hostname} --client-helo ${client_helo} --sasl-username ${sasl_username} --sender ${sender} -- ${recipient}

# ==============================================================================
# Queue runner
# ==============================================================================
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard

# ==============================================================================
# Local delivery (disabled - relay only)
# ==============================================================================
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
