# Copy to .env.local. This file is intentionally ignored by Git.
NULLAPART_POSTGRES_DB=nullapart
NULLAPART_POSTGRES_USER=nullapart
NULLAPART_POSTGRES_PASSWORD=replace-with-a-local-only-secret
NULLAPART_MAILCORE_DB_PASSWORD=replace-with-a-distinct-url-safe-local-only-secret
NULLAPART_POSTGRES_PORT=5433
NULLAPART_DEPLOYMENT_ID=LOCAL-TEST
NULLAPART_NODE_ID=mail-local-1
# Address every published port binds to (PostgreSQL, SMTP, UI, Mail Core, IdP).
NULLAPART_BIND_ADDRESS=127.0.0.1
# Local-only development values. Replace before any shared environment.
NULLAPART_HANDOFF_HMAC_KEY_ID=mail-handoff-v1
NULLAPART_HANDOFF_HMAC_SECRET=replace-with-a-local-only-hmac-secret
NULLAPART_DATABASE_URL=postgres://nullapart_mailcore:replace-with-a-distinct-url-safe-local-only-secret@127.0.0.1:5433/nullapart
NULLAPART_HANDOFF_LISTEN=127.0.0.1:8080
# Reverse-proxy boundary in front of the Control Plane (frontend/nginx).
NULLAPART_LOCAL_CONTROL_TOKEN=replace-with-a-local-only-control-token
# Bearer token for the internal mail-trace workload API (empty disables it).
NULLAPART_TRACE_WORKLOAD_TOKEN=replace-with-a-local-only-trace-workload-token
# Optional DNS resolver host:port used for domain TXT verification (empty uses
# the built-in default). Point at a local resolver for offline verification.
NULLAPART_DNS_RESOLVER=
NULLAPART_LOCAL_UI_USER=ob1
NULLAPART_LOCAL_UI_PASSWORD=replace-with-a-local-only-reverse-proxy-password

# Identity (Phase 3). proxy_header is the default and keeps IdP-less
# development and CI working; switch to oidc only after the local ZITADEL is
# provisioned (see infrastructure/containers/LOCAL-DEVELOPMENT.md).
NULLAPART_IDENTITY_PROVIDER=proxy_header
# First-run ZITADEL instance credentials. The admin's login local part should
# match an existing admin_users.login so the first OIDC login links to it.
NULLAPART_ZITADEL_MASTERKEY=replace-with-a-32-byte-hex-local-only-masterkey
NULLAPART_ZITADEL_DB_PASSWORD=replace-with-a-distinct-local-only-secret
NULLAPART_ZITADEL_ADMIN_USERNAME=ob1@nullapart.local
NULLAPART_ZITADEL_ADMIN_EMAIL=ob1@nullapart.local
NULLAPART_ZITADEL_ADMIN_PASSWORD=replace-with-a-local-only-admin-password
NULLAPART_ZITADEL_BOOTSTRAP_USERNAME=nullapart-local-bootstrap
NULLAPART_ZITADEL_LOGINCLIENT_USERNAME=nullapart-local-login-client
# NULLAPART_OIDC_ISSUER/_REDIRECT_URI/_CLIENT_ID/_CLIENT_SECRET are written by
# infrastructure/containers/provision-local-zitadel.sh; leave them unset in
# proxy_header mode.
